# --- Telegram ---
# Get this from @BotFather. NEVER commit the real value.
BOT_TOKEN=

# --- Database ---
# Path to the SQLite database file (created automatically by `npm run migrate`).
DATABASE_PATH=./data/interestmatch.db

# --- Admins ---
# Comma-separated Telegram numeric user IDs. Grants access to the admin service.
# Example: ADMIN_IDS=111111111,222222222
ADMIN_IDS=

# --- App ---
NODE_ENV=development
LOG_LEVEL=info

# Public deep-link base, e.g. https://t.me/YourBotUsername
BOT_PUBLIC_USERNAME=

# Menu image (HTTP/HTTPS URL accepted by Telegram sendPhoto)
MENU_IMAGE_URL=https://files.catbox.moe/qd2kor.jfif

# --- Feature flags (premium-ready scaffolding; no payment processing wired up) ---
# Comma-separated plan tiers a user can be assigned internally: free,plus,pro
ENABLE_PLAN_TIERS=true
